# Copy to services/api/.env (gitignored) and fill in. Never commit real values.
GAME_API_ENVIRONMENT=local            # local | shared | production
GAME_API_ALLOW_GUESTS=true            # only honoured when ENVIRONMENT=local

# Supabase > Project Settings > Database. Direct (IPv6), session pooler (5432) and transaction pooler (6543) all work:
# the API does not use server-side prepared statements.
GAME_API_DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Pick ONE, matching Project Settings > JWT Keys
GAME_API_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
# GAME_API_JWT_SECRET=<legacy shared secret>
GAME_API_JWT_ISSUER=https://<ref>.supabase.co/auth/v1
GAME_API_JWT_AUDIENCE=authenticated

# Shared with the Godot server, which reads it as GAME_API_SERVER_KEY
GAME_API_SERVER_API_KEY=<long random string>
