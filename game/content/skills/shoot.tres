[gd_resource type="Resource" script_class="SkillDef" format=3]

[ext_resource type="Script" path="res://game/shared/domain/skill_def.gd" id="1_def"]
[ext_resource type="Script" path="res://game/shared/domain/skill_stage.gd" id="2_def"]
[ext_resource type="Script" path="res://game/shared/domain/skill_effect.gd" id="3_def"]
[ext_resource type="Script" path="res://game/shared/domain/damage_effect.gd" id="4_def"]
[ext_resource type="Script" path="res://game/shared/domain/interrupt_effect.gd" id="5_def"]

[sub_resource type="Resource" id="Stage_draw"]
script = ExtResource("2_def")
stage_name = "draw"

[sub_resource type="Resource" id="Damage_shoot"]
script = ExtResource("4_def")
base = 8

[sub_resource type="Resource" id="Interrupt_shoot"]
script = ExtResource("5_def")
points = 1

[sub_resource type="Resource" id="Stage_shoot"]
script = ExtResource("2_def")
stage_name = "shoot"
effects = Array[ExtResource("3_def")]([SubResource("Damage_shoot"), SubResource("Interrupt_shoot")])

[resource]
script = ExtResource("1_def")
id = "shoot"
display_name = "Shoot"
hint = "Click a character (2 stages)"
description = "Draw the bow, then loose an arrow at a character you can see."
targeting = 1
attack_range = 5
speed = 5
stage_defs = Array[ExtResource("2_def")]([SubResource("Stage_draw"), SubResource("Stage_shoot")])
