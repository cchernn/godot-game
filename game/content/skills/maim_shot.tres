[gd_resource type="Resource" script_class="SkillDef" format=3]

[ext_resource type="Script" path="res://game/shared/domain/skill_def.gd" id="1_def"]
[ext_resource type="Script" path="res://game/shared/domain/skill_stage.gd" id="2_def"]
[ext_resource type="Script" path="res://game/shared/domain/skill_effect.gd" id="3_def"]
[ext_resource type="Script" path="res://game/shared/domain/damage_effect.gd" id="4_def"]
[ext_resource type="Script" path="res://game/shared/domain/interrupt_effect.gd" id="5_def"]
[ext_resource type="Script" path="res://game/shared/domain/apply_status_effect.gd" id="6_def"]
[ext_resource type="Resource" path="res://game/content/statuses/maimed.tres" id="7_def"]

[sub_resource type="Resource" id="Stage_draw"]
script = ExtResource("2_def")
stage_name = "draw"

[sub_resource type="Resource" id="Damage_maim"]
script = ExtResource("4_def")
base = 4

[sub_resource type="Resource" id="Interrupt_maim"]
script = ExtResource("5_def")
points = 3

[sub_resource type="Resource" id="Maim"]
script = ExtResource("6_def")
status = ExtResource("7_def")
chance_percent = 50

[sub_resource type="Resource" id="Stage_maim"]
script = ExtResource("2_def")
stage_name = "shoot"
effects = Array[ExtResource("3_def")]([SubResource("Damage_maim"), SubResource("Interrupt_maim"), SubResource("Maim")])

[resource]
script = ExtResource("1_def")
id = "maim_shot"
display_name = "Maim Shot"
hint = "Click a character (2 stages)"
description = "Draw the bow and shoot to cripple: it barely hurts but knocks a target's skill off hard, and has a chance to maim them, so they cannot attack or use skills for a turn."
action_slot = 3
targeting = 1
attack_range = 5
speed = 5
stage_defs = Array[ExtResource("2_def")]([SubResource("Stage_draw"), SubResource("Stage_maim")])
