[gd_resource type="Resource" script_class="StoryDef" format=3]

[ext_resource type="Script" path="res://game/shared/domain/story_def.gd" id="1_def"]
[ext_resource type="Script" path="res://game/shared/domain/story_slide.gd" id="2_slide"]
[ext_resource type="Script" path="res://game/shared/domain/story_choice.gd" id="3_choice"]
[ext_resource type="Resource" path="res://game/content/stories/actors/lich.tres" id="a_lich"]
[ext_resource type="Resource" path="res://game/content/stories/actors/scout.tres" id="a_scout"]

[sub_resource type="Resource" id="S0"]
script = ExtResource("2_slide")
text = "The gate gives way. Beyond it the trees part on a clearing, silver with moonlight that has no business being there."
backdrop_color = Color(0.06, 0.08, 0.14, 1)

[sub_resource type="Resource" id="S1"]
script = ExtResource("2_slide")
text = "A figure stands on a low mound at the far end, robes stirring in a wind that does not reach you."

[sub_resource type="Resource" id="S2"]
script = ExtResource("2_slide")
actor = ExtResource("a_lich")
side = 1
text = "Another band of the curious. The wood has been generous with visitors this season."

[sub_resource type="Resource" id="S3"]
script = ExtResource("2_slide")
actor = ExtResource("a_scout")
text = "Who are you? What are you guarding?"

[sub_resource type="Resource" id="S4"]
script = ExtResource("2_slide")
actor = ExtResource("a_lich")
side = 1
text = "Guarding? I am keeping a promise. Ten winters I have kept it, and I will not break it for the likes of you."

[sub_resource type="Resource" id="S5"]
script = ExtResource("2_slide")
actor = ExtResource("a_lich")
side = 1
text = "Turn back, and I let you walk. Press on, and you join the wood."

[resource]
script = ExtResource("1_def")
title = "The Clearing"
slides = Array[ExtResource("2_slide")]([SubResource("S0"), SubResource("S1"), SubResource("S2"), SubResource("S3"), SubResource("S4"), SubResource("S5")])
