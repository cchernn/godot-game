[gd_resource type="Resource" script_class="StoryDef" format=3]

[ext_resource type="Script" path="res://game/shared/domain/story_def.gd" id="1_def"]
[ext_resource type="Script" path="res://game/shared/domain/story_slide.gd" id="2_slide"]
[ext_resource type="Script" path="res://game/shared/domain/story_choice.gd" id="3_choice"]
[ext_resource type="Resource" path="res://game/content/stories/actors/emerald_serpent.tres" id="a_emerald_serpent"]
[ext_resource type="Resource" path="res://game/content/stories/actors/scout.tres" id="a_scout"]

[sub_resource type="Resource" id="S0"]
script = ExtResource("2_slide")
text = "The theatre's floor has split. Below it is a pit of churned earth, roots torn out like veins, and in the middle of it a living wall of green scale."
backdrop_color = Color(0.09, 0.07, 0.05, 1)

[sub_resource type="Resource" id="S1"]
script = ExtResource("2_slide")
text = "A dragon's head and shoulders rear out of the ground. The rest of it is buried, and only the tip of a tail lies across the pit like a fallen tree."

[sub_resource type="Resource" id="S2"]
script = ExtResource("2_slide")
actor = ExtResource("a_emerald_serpent")
side = 1
text = "Ten winters in the dark, and they send me small things. Come closer. Let me see what the wood has brought me."

[sub_resource type="Resource" id="S3"]
script = ExtResource("2_slide")
actor = ExtResource("a_scout")
text = "It speaks."

[sub_resource type="Resource" id="C4_0"]
script = ExtResource("3_choice")
id = "defy"
text = "We have come to end you."
next = "defy_line"

[sub_resource type="Resource" id="C4_1"]
script = ExtResource("3_choice")
id = "listen"
text = "What are you? Who sealed you here?"
next = "listen_line"

[sub_resource type="Resource" id="S4"]
script = ExtResource("2_slide")
actor = ExtResource("a_emerald_serpent")
side = 1
text = "I have had a long time to practise."
choices = Array[ExtResource("3_choice")]([SubResource("C4_0"), SubResource("C4_1")])

[sub_resource type="Resource" id="S5"]
script = ExtResource("2_slide")
id = "defy_line"
actor = ExtResource("a_emerald_serpent")
side = 1
text = "Brave. They always begin that way."
next = "after"

[sub_resource type="Resource" id="S6"]
script = ExtResource("2_slide")
id = "listen_line"
actor = ExtResource("a_emerald_serpent")
side = 1
text = "Wardens, once. Friends of mine. They bound me with emerald and left the wood to guard the knot."

[sub_resource type="Resource" id="S7"]
script = ExtResource("2_slide")
id = "after"
actor = ExtResource("a_emerald_serpent")
side = 1
text = "Break the knot, and I am free. Fail, and you feed the wood. Come."

[resource]
script = ExtResource("1_def")
title = "The Serpent"
slides = Array[ExtResource("2_slide")]([SubResource("S0"), SubResource("S1"), SubResource("S2"), SubResource("S3"), SubResource("S4"), SubResource("S5"), SubResource("S6"), SubResource("S7")])
