class_name ContentCatalog
extends RefCounted
## What the API needs to know about the game's content to keep inventories honest (which gear fits which slot, how many copies of an
## item stack, what a class starts with). Built from the content resources, written to services/api/app/catalog.json by
## tools/export_catalog.gd, and checked against that file by a test, so the two cannot drift apart silently.

const FILE := "res://services/api/app/catalog.json"
const CLASSES_DIR := "res://game/content/stats/classes"


static func build(cfg: GameConfig) -> Dictionary:
	var gear := {}
	for g in GearSet.load_file().gear:
		gear[g.id] = {"slot": g.slot_name()}
	var items := {}
	for id: String in SkillDb.load_file().items:
		items[id] = {"max_stack": (SkillDb.load_file().items[id] as ItemDef).max_stack}
	var classes := {}
	for f in DirAccess.get_files_at(CLASSES_DIR):
		if not f.ends_with(".tres"):
			continue
		var t := load("%s/%s" % [CLASSES_DIR, f]) as UnitTemplate
		var worn: Array = []
		for g in t.gear:
			worn.append(g.id)
		classes[t.id] = {"gear": worn}
	return {
		"_note": "Generated by tools/export_catalog.gd from the game content; do not edit by hand.",
		"worn_places": GearDef.WORN_PLACES.duplicate(),
		"battle_slots": int(cfg.get_value("items", "battle_slots")),
		"chat": {
			"max_length": int(cfg.get_value("chat", "max_length")),
			"rate_messages": int(cfg.get_value("chat", "rate_messages")),
			"rate_seconds": int(cfg.get_value("chat", "rate_seconds")),
		},
		"gear": gear,
		"items": items,
		"classes": classes,
	}


## The JSON text of the catalog, with sorted keys so the file only changes when the content does.
static func to_json(catalog: Dictionary) -> String:
	return JSON.stringify(catalog, "  ", true) + "\n"
