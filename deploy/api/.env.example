# Copy to deploy/api/.env (gitignored). Run: docker compose -f deploy/api/compose.yaml up -d --build

# --- Public address (Caddy gets the HTTPS certificate for this domain) ---
SITE_ADDRESS=api.example.com
HTTP_PORT=80
HTTPS_PORT=443
# Private address the game server calls (/internal/*). Use this host's private IP on a server.
API_PRIVATE_BIND=127.0.0.1
API_PRIVATE_PORT=8000
# Optional: pull a prebuilt image instead of building (e.g. from ECR)
# API_IMAGE=123456789.dkr.ecr.eu-west-1.amazonaws.com/unnamed-api:latest

# --- API settings ---
GAME_API_ENVIRONMENT=production       # local | shared | production
GAME_API_ALLOW_GUESTS=false           # honoured only when ENVIRONMENT=local
# Any Supabase connection string works (direct, session pooler 5432 or transaction pooler 6543).
GAME_API_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
GAME_API_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
# GAME_API_JWT_SECRET=
GAME_API_JWT_ISSUER=https://<ref>.supabase.co/auth/v1
GAME_API_JWT_AUDIENCE=authenticated
# Must equal GAME_API_SERVER_KEY on the game server: openssl rand -hex 32
GAME_API_SERVER_API_KEY=<long random string>
# Browser origin(s) of the web client, as a JSON list
GAME_API_CORS_ORIGINS=["https://play.example.com"]
