# Copy to deploy/vm/.env (gitignored) and fill in. Then, from the repository root:
#   docker compose -f deploy/vm/compose.yaml up -d --build

# --- Your domain: three host names, each with a DNS A record pointing at this machine ---
# The web client's address is what players open. The URLs are baked into the web build, so changing them needs a rebuild.
WEB_HOST=game.example.com
API_HOST=api.example.com
PLAY_HOST=play.example.com

# --- Supabase: use a PRODUCTION project, separate from the one you test with ---
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
GAME_API_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
GAME_API_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
# GAME_API_JWT_SECRET=      # only for projects that still sign with the legacy shared secret
GAME_API_JWT_ISSUER=https://<ref>.supabase.co/auth/v1
GAME_API_JWT_AUDIENCE=authenticated

# --- Shared secret between the API and the battle server: openssl rand -hex 32 ---
GAME_API_SERVER_API_KEY=<long random string>
