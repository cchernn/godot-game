# Copy to deploy/game/.env (gitignored). Run: docker compose -f deploy/game/compose.yaml up -d --build

SITE_ADDRESS=game.example.com
HTTP_PORT=80
HTTPS_PORT=443
# GAME_IMAGE=123456789.dkr.ecr.eu-west-1.amazonaws.com/unnamed-game:latest

# The API's PRIVATE address (VPC IP and API_PRIVATE_PORT). Not the public domain: /internal is blocked there.
API_URL=http://10.0.1.20:8000
# Must equal GAME_API_SERVER_API_KEY on the API host.
GAME_API_SERVER_KEY=<same long random string>
GAME_ENV=production
# Leave unset to serve any world (one room per world). Set a world's uuid to serve only that world.
# WORLD_ID=<uuid>
PLAYERS=3
# INSTANCE_ID=<optional activity instance uuid>
