# Copy to deploy/web/.env (gitignored). The URLs are baked into the build, so changing them needs a rebuild.
# Run: docker compose -f deploy/web/compose.yaml up -d --build

SITE_ADDRESS=play.example.com
HTTP_PORT=80
HTTPS_PORT=443
# WEB_IMAGE=123456789.dkr.ecr.eu-west-1.amazonaws.com/unnamed-web:latest

SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
WORLD_ID=<same world as the game server>
API_URL=https://api.example.com
SERVER_URL=wss://game.example.com
